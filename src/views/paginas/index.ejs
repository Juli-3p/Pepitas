<script>
let pagina = 0;

function moverDerecha(){

    const container =
        document.getElementById("productosContainer");

    pagina = 1;

    container.style.transform =
        "translateX(-1180px)";
}

function moverIzquierda(){

    const container =
        document.getElementById("productosContainer");

    pagina = 0;

    container.style.transform =
        "translateX(0px)";
}
</script>