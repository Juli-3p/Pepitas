<link rel="stylesheet" href="/css/index.css">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>

document.addEventListener("DOMContentLoaded", () => {

    const slider = document.getElementById("slider");
    const btnDer = document.getElementById("btnDer");
    const btnIzq = document.getElementById("btnIzq");

    let posicion = 0;
    btnDer.addEventListener("click", () => {
        posicion -= 1200;
        const limite = -(slider.scrollWidth - 1200);
        if(posicion < limite){
            posicion = limite;
        }
        slider.style.transform = `translateX(${posicion}px)`;
    });
    btnIzq.addEventListener("click", () => {
        posicion += 1200;
        if(posicion > 0){
            posicion = 0;
        }
        slider.style.transform = `translateX(${posicion}px)`;
    });
});
</script>

<%- include('../partials/header') %>

    <div class="sort-buttons">
        <a href="/?sort=asc">
            <button>Precio ↑</button>
        </a>

        <a href="/?sort=desc">
            <button>Precio ↓</button>
        </a>
    </div>
    
<h2 class="titulo-seccion">
    Te puede interesar
</h2>
<section class="productos-container">
    <% suggestedProducts.forEach(product => { %>
        <article class="producto">
            <div class="imagen">
                <a href="<%= product.id ? '/products/' + product.id : '/producto-no-encontrado' %>">
                    <img src="<%= product.image || '/imagen/fallback.png' %>" alt="<%= product.name %>">
                </a>
            </div>
            <h3><%= product.name %></h3>
            <p class="precio">$<%= product.price %></p>
            <form action="<%= product.id ? '/products/' + product.id : '/producto-no-encontrado' %>" method="GET">
                <button>Ver Producto</button>
            </form>
        </article>
    <% }) %>
</section>
<h2 class="titulo-seccion">
    Los más pedidos
</h2>
<div class="carrusel">
    <button type="button" class="btn izquierda" id="btnIzq">❮</button>
    <div class="viewport">
        <div class="productos-container" id="slider">
            <% featuredProducts.forEach(product => { %>
                <article class="producto">
                    <div class="imagen">
                        <a href="<%= product.id ? '/products/' + product.id : '/producto-no-encontrado' %>">
                            <img src="<%= product.image %>" alt="<%= product.name %>">
                        </a>
                    </div>
                    <h3><%= product.name %></h3>
                    <p class="precio">$<%= product.price %></p>
                    <form action="<%= product.id ? '/products/' + product.id : '/producto-no-encontrado' %>" method="GET">
                        <button>Ver Producto</button>
                    </form>
                </article>
            <% }) %>
        </div>
    </div>
    <button type="button" class="btn derecha" id="btnDer">❯</button>  
</div>
