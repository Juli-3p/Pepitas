<link rel="stylesheet" href="/css/index.css">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<div class="principal">

<%- include('../partials/header') %>

<h2 class="titulo-seccion">
    Te puede interesar
</h2>
<section class="productos-container">
    <% suggestedProducts.forEach(product => { %>
        <article class="producto">
            <div class="imagen">
                <a href="<%= product.name.includes('Termo Ozz') ? '/vistProd' : '#' %>">
                    <img src="<%= product.image || '/imagen/fallback.png' %>" alt="<%= product.name %>">
                </a>
            </div>
            <h3><%= product.name %></h3>
            <p class="precio">$<%= product.price %></p>
            <form action="<%= product.name.includes('Termo Ozz') ? '/vistProd' : '#' %>" method="GET">
                <button>Ver Producto</button>
            </form>
        </article>
    <% }) %>
</section>
<h2 class="titulo-seccion">
    Los más pedidos
</h2>
<div class="carrusel">
    <button class="btn izquierda" onclick="moverIzquierda()">❮</button>
    <div class="viewport">
        <section class="productos-container" id="productosContainer">
            <% featuredProducts.forEach(product => { %>
                <article class="producto">
                    <div class="imagen">
                        <a href="<%= product.name.includes('Termo Ozz') ? '/vistProd' : '#' %>">
                            <img src="<%= product.image || '/imagen/fallback.png' %>" alt="<%= product.name %>">
                        </a>
                    </div>
                    <h3><%= product.name %></h3>
                    <p class="precio">$<%= product.price %></p>
                    <form action="<%= product.name.includes('Termo Ozz') ? '/vistProd' : '#' %>" method="GET">
                        <button>Ver Producto</button>
                    </form>
                </article>
            <% }) %>
        </section>
    </div>
    <button class="btn derecha" onclick="moverDerecha()">❯</button>
</div>
