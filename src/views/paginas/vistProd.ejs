<link rel="stylesheet" href="/css/vistProd.css">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<div class="principal">

    <section id="vistProd">
        <article class="producto">
            <div class="imagenSecun">
                <img src="/imagen/Termo ozz.png">
                <img src="/imagen/Termo ozz2.png">
            </div>
            <div class="imagen">
                <img src="/imagen/termo.png">
            </div>
            <div class="info">
                <h3>Termo Ozz 1Lt Doble Pared Con Pico Cebador Y 360°</h3>
                <p class="precio">$29.999</p>
                <p class="descripcion">Acero inoxidable de alta calidad con un control avanzado de temperatura. 
                    Dos picos vertedores intercambiables con precision y vertido normal. 
                    Diseño moderno elegante y ergonomico. 
                    Satisfaccion garantizada.</p>
                <a class="btn-carrito" href="/agregar/1">Agregar producto al carrito</a>
                </div>
        </article>
    </section>
    <h2>Productos Relacionados</h2>

    <section id="prodRelacionados">

        <% relatedProducts.forEach(producto => { %>

            <article class="producto1">

                <div class="imagen1">

                    <a href="/products/<%= producto.id %>">

                        <img 
                            src="<%= producto.image || '/imagen/fallback.png' %>" 
                            alt="<%= producto.name %>"
                        >

                    </a>

                </div>

                <h3><%= producto.name %></h3>

                <p class="precio1">
                    $<%= producto.price %>
                </p>

                <a href="/products/<%= producto.id %>">

                    <button>
                        Ver producto
                    </button>

                </a>

            </article>

        <% }) %>

    </section>

    <%- include('../partials/footer') %>

</div>