<link rel="stylesheet" href="/css/vistProd.css">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<div class="principal">

    <section id="vistProd">
        <article class="producto">
        <div class="imagenSecun">
            <img src="<%= product.image || '/imagen/fallback.png' %>" alt="<%= product.name %>">
            <img src="<%= product.image || '/imagen/fallback.png' %>" alt="<%= product.name %>">
        </div>
        <div class="imagen">
            <img src="<%= product.image || '/imagen/fallback.png' %>" alt="<%= product.name %>">
        </div>
        <div class="info">
            <h3><%= product.name %></h3>
            <p class="precio">$<%= product.price %></p>
            <p class="categoria">Categoría: <%= product.category %></p>
            <p class="descripcion"><%= product.description %></p>

            <% if (product.stock > 0) { %>

                <a class="btn-carrito" href="/agregar/<%= product.id %>">
                    Agregar producto al carrito
                </a>

            <% } else { %>

                <div class="sin-stock">
                    No hay stock
                </div>

            <% } %>
        </div>
    </article>
</section>
    <h2>Productos Relacionados</h2>

    <section id="prodRelacionados">

        <% relatedProducts.forEach(producto => { %>

            <article class="producto1">

                <div class="imagen1">

                    <a href="/products/<%= producto.id %>">

                        <img 
                            src="<%= producto.image || '/imagen/fallback.png' %>" 
                            alt="<%= producto.name %>"
                        >

                    </a>

                </div>

                <h3><%= producto.name %></h3>

                <p class="precio1">
                    $<%= producto.price %>
                </p>

                <a href="/products/<%= producto.id %>">

                    <button>
                        Ver producto
                    </button>

                </a>

            </article>

        <% }) %>

    </section>


</div>
