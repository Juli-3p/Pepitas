<link rel="stylesheet" href="/css/registro.css">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<div class="principal">
<header class="header" style="padding: 1em; margin-bottom: 1em">
<link rel="stylesheet" href="/css/header.css">
  
  <a href="/">
  <img src="/imagen/logo_pepitas.png" alt="Pepitas">
  </a>

  <div class="seccion">   
    <div class="usuario">...</div>
  </div>

</header>
    
    <div class="registro">
        <h1>¡Registrate!</h1>
        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
            <div class="alert errores">
                <ul>
                    <% errors.forEach(error => { %>
                        <li><%= error.msg %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>
        <% if (typeof success !== 'undefined') { %>
            <div class="alert exito"><%= success %></div>
        <% } %>
        <form action="/registro" method="POST">
            <input type="text" placeholder="Nombre" name="nombre" value="<%= typeof old !== 'undefined' && old.nombre ? old.nombre : '' %>" required>
            <input type="text" placeholder="Apellido" name="apellido" value="<%= typeof old !== 'undefined' && old.apellido ? old.apellido : '' %>" required>
            <input type="email" placeholder="Email" name="email" value="<%= typeof old !== 'undefined' && old.email ? old.email : '' %>" required>
            <input type="password" placeholder="Contraseña" name="password" required>
            <input type="password" placeholder="Repite tu contraseña" name="passwordConfirm" required>
            <button type="submit">Crear cuenta</button>
        </form>
        <p>¿Tienes una cuenta? <a class="enlaceLogeo" href="/logeo">Inicia sesion aquí</a></p>
    </div>
    <%- include('../partials/ventanaInicio') %>
    <%- include('../partials/footer') %>

</div>

<script>
    const ventanita = document.querySelector(".usuario");
    const ventanita2 = document.querySelector(".ventanaInicio");

    ventanita.addEventListener('click', () => {
        if (ventanita2.classList.contains("oculto")) {
            ventanita2.classList.remove("oculto");
            ventanita2.classList.add("visible");
        } else {
            ventanita2.classList.remove("visible");
            ventanita2.classList.add("oculto");
        }
    })
</script>