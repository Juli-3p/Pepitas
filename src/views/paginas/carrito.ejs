<link rel="stylesheet" href="/css/carrito.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <div class="principal">


    <div class="Volver">
      <a href="/">⬅ Volver</a>
    </div>
    <h2>Productos en tu Carrito</h2>

    <section id="ProductosCarrito">

      <% if (carrito.length === 0) { %>

        <p>Tu carrito esta vacio.</p>

      <% } %>

        <% (carrito || []).forEach(producto => { %>

        <article class="producto">

          <div class="izquierda">

            <div class="imagen">
              <img src="<%= producto.image %>">
            </div>

            <div class="ProductInfo">
              <h3><%= producto.name %></h3>
            </div>

          </div>

          <div class="derecha">

            <a href="/quitar/<%= producto.id %>">
              <button><b>Quitar</b></button>
            </a>

            <div class="cantidad">

              <a href="/restar/<%= producto.id %>">
                <button class="menos">-</button>
              </a>

              <input
                type="text"
                value="<%= producto.quantity %>"
                readonly
              >

              <a href="/agregar/<%= producto.id %>">
                <button class="mas">+</button>
              </a>

            </div>

            <p class="precio">
              $<%= (producto.price * producto.quantity).toLocaleString('es-AR') %>
            </p>

          </div>

        </article>

      <% }) %>

    </section>
    <section>
      <article class="Pagar">
        <div class="TotalPagar">
          <p>
            Total a Pagar:
            <b>$<%= total.toLocaleString('es-AR') %></b>
          </p>
        </div>
        <div class="VaciarComprar">
          <a href="/vaciar-carrito">
            <button><b>Vaciar carrito</b></button>
          </a>

          <button><b>Comprar</b></button>
        </div>
      </article>
    </section>
    
