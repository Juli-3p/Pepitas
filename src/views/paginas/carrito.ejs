<link rel="stylesheet" href="/css/carrito.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <div class="principal">

  <%- include('../partials/header') %>

    <div class="Volver">
      <a href="/">⬅ Volver</a>
    </div>
    <h2>Productos en tu Carrito</h2>

    <section id="ProductosCarrito">

        <% (carrito || []).forEach(producto => { %>

        <article class="producto">

          <div class="izquierda">

            <div class="imagen">
              <img src="<%= producto.image %>">
            </div>

            <div class="ProductInfo">
              <h3><%= producto.name %></h3>
            </div>

          </div>

          <div class="derecha">

            <a href="/quitar/<%= producto.id %>">
              <button><b>Quitar</b></button>
            </a>

            <div class="cantidad">

              <button class="menos">-</button>

              <input
                type="text"
                value="<%= producto.quantity %>"
                readonly
              >

              <button class="mas">+</button>

            </div>

            <p class="precio">
              $<%= (producto.price * producto.quantity).toLocaleString('es-AR') %>
            </p>

          </div>

        </article>

      <% }) %>

    </section>
    <section>
      <article class="Pagar">
        <div class="TotalPagar">
          <p>Total a Pagar: <b>59.181</b></p>
        </div>
        <div class="Comprar">
          <button><b>Comprar</b></button>
        </div>
      </article>
    </section>

    <script>
      document.querySelectorAll('.cantidad').forEach(cantidad => {

        const input = cantidad.querySelector('input');
        const btnMas = cantidad.querySelector('.mas');
        const btnMenos = cantidad.querySelector('.menos');

        btnMas.addEventListener('click', () => {
          input.value = parseInt(input.value) + 1;
        });

        btnMenos.addEventListener('click', () => {
          let valor = parseInt(input.value);

          if (valor > 1) {
            input.value = valor - 1;
          }
        });

      });
    </script>
    
  <%- include('../partials/footer') %>
