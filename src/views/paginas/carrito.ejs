<link rel="stylesheet" href="/css/carrito.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <div class="principal">

  <%- include('../partials/header') %>

    <div class="Volver">
      <a href="/">⬅ Volver</a>
    </div>
    <h2>Productos en tu Carrito</h2>

    <section id="ProductosCarrito">
      <article class="producto">
        <div class="izquierda">
          <div class="imagen">
            <img src="/imagen/termo.png">
          </div>
          <div class="ProductInfo">
            <h3>Termo Ozz 1l Doble Pared Con Pico Cebador Y 360°</h3>
          </div>
        </div>
        <div class="derecha">
          <button><b>Quitar</b></button>

          <div class="cantidad">
            <button class="menos">-</button>
            <input type="text" value="1" readonly>
            <button class="mas">+</button>
          </div>

          <p class="precio">$29.999</p>
        </div>
      </article>
      
      <article class="producto">
          <div class="izquierda">
            <div class="imagen">
              <img src="/imagen/mate 3.png">
            </div>
            <div class="ProductInfo">
              <h3>Mate Térmico De Acero Inox. Doble Pared - 160 Ml Color Azul 160ml</h3>
            </div>
          </div>
        <div class="derecha">
          <button><b>Quitar</b></button>

          <div class="cantidad">
            <button class="menos">-</button>
            <input type="text" value="1" readonly>
            <button class="mas">+</button>
          </div>

          <p class="precio">$15.895</p>
        </div>
      </article>
      <article class="producto">
        <div class="izquierda">
          <div class="imagen">
            <img src="/imagen/bombilla.png">
          </div>
          <div class="ProductInfo">
            <h3>Bombilla Alpaca Curva Uruguaya Pico De Loro Chata Plana</h3>
          </div>
        </div>
        <div class="derecha">
          <button><b>Quitar</b></button>

          <div class="cantidad">
            <button class="menos">-</button>
            <input type="text" value="1" readonly>
            <button class="mas">+</button>
          </div>

          <p class="precio">$13.197</p>
        </div>
      </article>
    </section>
    <section>
      <article class="Pagar">
        <div class="TotalPagar">
          <p>Total a Pagar: <b>59.181</b></p>
        </div>
        <div class="Comprar">
          <button><b>Comprar</b></button>
        </div>
      </article>
    </section>

    <script>
      document.querySelectorAll('.cantidad').forEach(cantidad => {

        const input = cantidad.querySelector('input');
        const btnMas = cantidad.querySelector('.mas');
        const btnMenos = cantidad.querySelector('.menos');

        btnMas.addEventListener('click', () => {
          input.value = parseInt(input.value) + 1;
        });

        btnMenos.addEventListener('click', () => {
          let valor = parseInt(input.value);

          if (valor > 1) {
            input.value = valor - 1;
          }
        });

      });
    </script>
    
  <%- include('../partials/footer') %>
