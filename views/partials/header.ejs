<header class="header" style="padding: 1em; margin-bottom: 1em">
  <link rel="stylesheet" href="/css/header.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <a href="/">
  <img src="/imagen/logo_pepitas.png" alt="Pepitas">
</a>

  <div class="buscador">
    <input type="text" placeholder="Buscar productos..." />
    <button>🔍</button>
  </div>

  <div class="seccion">
    <div class="carrito">
      <a href="/carrito">
        🛒<span class="bolsa">3</span>
      </a>
    </div>
    <div class="usuario">...</div>
    <%- include('../partials/ventanaInicio') %>
  </div>

  <script>
    const ventanita = document.querySelector(".usuario");
    const ventanita2 = document.querySelector(".ventanaInicio");

    ventanita.addEventListener('click', () => {
        if (ventanita2.classList.contains("oculto")) {
            ventanita2.classList.remove("oculto");
            ventanita2.classList.add("visible");
        } else {
            ventanita2.classList.remove("visible");
            ventanita2.classList.add("oculto");
        }
    })
    </script>

</header>
