<link rel="stylesheet" href="/css/registro.css">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<div class="principal">
    
    <header class="header" style="padding: 1em; margin-bottom: 1em">
  <link rel="stylesheet" href="/css/header.css">
  
  <a href="/">
  <img src="/imagen/logo_pepitas.png" alt="Pepitas">
  </a>

  <div class="seccion">   
    <div class="usuario">...</div>
  </div>

</header>
    
    <div class="registro">
        <h1>¡Registrate!</h1>
        <form action="/registro" method="POST">
            <input type="text" placeholder="Email" name="usuario nuevo" required>
            <input type="password" placeholder="Nueva contraseña" name="contraseña nueva" required>
            <input type="password" placeholder="Repite tu contraseña" name="repite contraseña" required>
            <button type="submit">Crear cuenta</button>
        </form>
        <p>¿Tienes una cuenta? <a class="enlaceLogeo" href="/logeo">Inicia sesion aquí</a></p>
    </div>
    <%- include('../partials/ventanaInicio') %>
<%- include('../partials/footer') %>

</div>

<script>
    const ventanita = document.querySelector(".usuario");
    const ventanita2 = document.querySelector(".ventanaInicio");

    ventanita.addEventListener('click', () => {
        if (ventanita2.classList.contains("oculto")) {
            ventanita2.classList.remove("oculto");
            ventanita2.classList.add("visible");
        } else {
            ventanita2.classList.remove("visible");
            ventanita2.classList.add("oculto");
        }
    })
</script>
